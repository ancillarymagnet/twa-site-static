---
// thirdwave.fun/garys-party-line: the game page for Gary's Party Line (code name LINE).
// 2026-11-11: copy is Noah's (artifact comments). Media is cut from RECORD takes, TW_TAKEAWAYS
// and the 11-11 playtest. Credits carry what wndrvl.astro has, plus a list still to gather.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getEntry } from 'astro:content';

const siteEntry = await getEntry('site', 'site');
const siteData = siteEntry.data;

const V = '261111v01';
const m = (name: string) => ({ src: `/gpl/gpl-${name}-${V}.mp4`, poster: `/gpl/gpl-${name}-${V}.webp` });

// Labels and tags: Noah's copy (artifact comments, 2026-11-11).
const play = [
	{ src: '/gpl/gpl-mechanics-261112v08.mp4', poster: '/gpl/gpl-mechanics-261112v08.webp', label: 'Draw the line', tag: 'Constantly-shifting dynamics explore the space of drawing-enabled team physics puzzling.' },
	{ src: '/gpl/gpl-course-map-261111v02.mp4', poster: '/gpl/gpl-course-map-261111v02.webp', label: 'Three ways to play', tag: 'Each course explores a theme.' },
	{ src: '/gpl/gpl-driving-school-261111v02.mp4', poster: '/gpl/gpl-driving-school-261111v02.webp', label: "Gary's Driving School", tag: "Gary's Driving School requires teams to divide and conquer to accomplish goals while trying not to get KO'd." },
	{ src: '/gpl/gpl-choice-words-261111v02.mp4', poster: '/gpl/gpl-choice-words-261111v02.webp', label: 'Choice Words', tag: 'In Choice Words with Gary, drop words to your teammates as they try to balance the tallest tower.' },
	{ src: '/gpl/gpl-godhead-261111v02.mp4', poster: '/gpl/gpl-godhead-261111v02.webp', label: "Gary's Parents Journey into the Godhead", tag: "Gary's Parents Journey Into the Godhead makes literal the metaphor of passage into another spacetime." },
	{ src: '/gpl/gpl-courses-261111v02.mp4', poster: '/gpl/gpl-courses-261111v02.webp', label: 'Pick a course', tag: 'Arcade mode lets players vote on which course to play next.' },
];

// Clip 3 v02: the 13:17 Noclip match (v01 showed a sim winning).
const matchClips = [{ src: '/gpl/gpl-match-clip-1-261112v02.mp4', poster: '/gpl/gpl-match-clip-1-261112v02.webp' }, m('match-clip-2'), { src: '/gpl/gpl-match-clip-3-261111v02.mp4', poster: '/gpl/gpl-match-clip-3-261111v02.webp' }];
// Award cards from every game. Each swap brings in a card from a different game than the one leaving.
// The first four are the row's opening hand: one per game.
const award = (file: string, alt: string) => ({ src: `/gpl/gpl-award-${file}.webp`, alt: `Award card: ${alt}`, game: alt.split(', from ')[1] });
const awards = [
	award('driving-school-first-blood-261112v01', "First Blood, from Gary's Driving School"),
	award('most-261111v01', 'Heavy Hand, from Draw the Line'),
	award('choice-words-top-word-261112v01', 'Top Word, from Choice Words'),
	award('godhead-enlightened-261112v01', 'Enlightened, from the Godhead'),
	award('closer-261111v01', 'Closer, from Draw the Line'),
	award('stork-261111v01', 'Stork, from Draw the Line'),
	award('brick-261111v01', 'Brick Wall, from Draw the Line'),
	award('longest-261111v01', 'Longest Line, from Draw the Line'),
	award('butterfingers-261112v02', 'Butterfingers, from Draw the Line'),
	award('witness-261112v02', 'Witness, from Draw the Line'),
];
const SLOTS = 4;

// Same lines as wndrvl.astro (each font's OFL.txt, read 2026-10-02 from tw-controller-demo).
const fonts = [
	{ before: 'Copyright 2019 The Big Shoulders Project Authors (', url: 'https://github.com/xotypeco/big_shoulders', after: ')' },
	{ before: 'Copyright 2020 The Anton Project Authors (', url: 'https://github.com/googlefonts/AntonFont.git', after: ')' },
	{ before: 'Copyright 2025 The SUSE Project Authors (', url: 'https://github.com/SUSE/suse-font', after: ')' },
	{ before: 'Copyright © 2017 IBM Corp. with Reserved Font Name "Plex"', url: null, after: '' },
	{ before: 'Copyright 2020-2024 The Atkinson Hyperlegible Next Project Authors (', url: 'https://github.com/googlefonts/atkinson-hyperlegible-next', after: ')' },
	{ before: 'Copyright 2018 The Lexend Project Authors (', url: 'https://github.com/googlefonts/lexend', after: '), with Reserved Font Name “RevReading Lexend”.' },
];

---

<Layout
	title="Third Wave — Gary's Party Line"
	description="Gary's Party Line: an outrageous collaborative/competitive party game for up to 50 players."
>
	<Header
		status={siteData.topBar.status}
		meta={siteData.topBar.meta}
		ticker={siteData.ticker}
	/>

	<main class="gp" id="gp">
		<script is:inline>
			(function (main) {
				main.classList.add('is-pre');
				setTimeout(function () { main.classList.remove('is-pre'); }, 1500);
			})(document.currentScript.parentElement);
		</script>

		<div class="gp-hero b" style="--d: 0ms">
			<video class="loop" src="/gpl/gpl-title-261111v02.mp4" poster="/gpl/gpl-title-261111v02.webp" muted loop playsinline preload="metadata" aria-hidden="true"></video>
		</div>

		<div class="gp-top b" style="--d: 80ms">
			<span class="gp-place">A game for one screen and up to 50 IRL players</span>
		</div>

		<div class="gp-col">
			<h1 class="gp-h1 b" style="--d: 140ms">Gary's Party Line</h1>
			<p class="gp-copy gp-lede b" style="--d: 220ms">An outrageous collaborative/competitive party game for up to 50 players.</p>
			<p class="gp-copy b" style="--d: 300ms">3 distinct courses explore the game's core drawing mechanic as teams self-organize to solve spatial puzzles. Mini-games break things up with driving, tower-building, and metaphysical interludes.</p>
		</div>

		<section class="gp-sec">
			<h2 class="gp-label r">Gameplay</h2>
			<div class="gp-grid">
				{play.map((c, i) => (
					<figure class="gp-clip r" style={`--i: ${i % 2}`}>
						<video class="loop" src={c.src} poster={c.poster} muted loop playsinline preload="none" aria-label={c.label}></video>
						<figcaption><span>{c.label}</span> <span class="gp-tag">{c.tag}</span></figcaption>
					</figure>
				))}
			</div>
		</section>

		<section class="gp-sec">
			<h2 class="gp-label r">Takeaways</h2>
			<p class="gp-copy gp-narrow r">Every player leaves with personalized takeaways - videos, stills, achievements, and awards.</p>

			<h3 class="gp-sub r">Match clips</h3>
			<div class="gp-tall">
				{matchClips.map((c, i) => (
					<div class="r" style={`--i: ${i}`}><video class="loop" src={c.src} poster={c.poster} muted loop playsinline preload="none" aria-label="A match clip"></video></div>
				))}
			</div>

			<h3 class="gp-sub r">Award cards</h3>
			<div class="gp-cards" data-deck={JSON.stringify(awards)}>
				{awards.slice(0, SLOTS).map((a, i) => (
					<div class="gp-slot r" style={`--i: ${i}`}><img src={a.src} alt={a.alt} width="640" height="800" loading="lazy" decoding="async" /></div>
				))}
			</div>
		</section>

		<section class="gp-sec gp-col">
			<h2 class="gp-label r">Play it</h2>
			<p class="gp-copy r">Gary's Party Line is available to venues looking to keep 2-50 players losing their minds for hours on end. Sound like you? <a class="gp-cta" href="mailto:licensing@thirdwave.fun?subject=Gary's%20Party%20Line" onclick="window.twTrack && window.twTrack('licensing_interest')">Get in touch</a></p>
		</section>

		<div class="gp-col">
			<details class="gp-credits r">
				<summary>Credits</summary>
				<div class="gp-credits-body">
					<section>
						<h2>Music</h2>
						<p>Music by <a href="https://braillesounds.bandcamp.com/" target="_blank" rel="noopener noreferrer">Braille</a>.</p>
					</section>
					<section>
						<h2>Light</h2>
						<p>TD GI Component by <a href="https://www.patreon.com/prismaticvisuals/posts/tox-l2d-operator-155965844" target="_blank" rel="noopener noreferrer">Prismatic Visuals</a>.</p>
					</section>
					<section>
						<h2>Images</h2>
						<p>Public domain images from <a href="https://commons.wikimedia.org/" target="_blank" rel="noopener noreferrer">Wikimedia Commons</a>.</p>
					</section>
					<section>
						<h2>Type</h2>
						<ul>
							{fonts.map((f) => (
								<li>{f.before}{f.url && <a href={f.url} target="_blank" rel="noopener noreferrer">{f.url}</a>}{f.after}</li>
							))}
						</ul>
						<p>Licensed under the SIL Open Font License, Version 1.1.</p>
						<p>Noto Emoji images: Apache License 2.0.</p>
					</section>
					<section>
						<h2>Licenses</h2>
						<p>
							<a href="https://openfontlicense.org" target="_blank" rel="noopener noreferrer">SIL Open Font License 1.1</a> ·
							<a href="https://www.apache.org/licenses/LICENSE-2.0" target="_blank" rel="noopener noreferrer">Apache License 2.0</a>
						</p>
					</section>
				</div>
			</details>
		</div>
	</main>

	<Footer
		production={siteData.footer.production}
		copyrightHolder={siteData.footer.copyrightHolder}
		youtube={siteData.social.youtube}
		instagram={siteData.social.instagram}
	/>
</Layout>

<style>
	/*
	 * Motion. Above the fold (.b) builds in on load, staggered by --d (ease out) and builds
	 * off on a same-tab link tap in reverse (ease in). Below the fold (.r) rises in when it
	 * scrolls into view (staggered by --i) and fades back down when it leaves.
	 * Reduced motion: everything just shows; videos stay on their posters.
	 */
	.gp {
		--out: cubic-bezier(.33, 1, .68, 1);
		--in: cubic-bezier(.32, 0, .67, 0);
		--gutter: 22px;
		--accent: #ff3ea5;
		--accent-2: #2fb7ff;
	}

	.gp video, .gp img { display: block; width: 100%; height: auto; background: #111; }

	.gp-hero { position: relative; width: 100%; height: min(56.25vw, 70vh); overflow: hidden; }
	.gp-hero video { height: 100%; object-fit: cover; }

	.gp-top {
		display: flex; justify-content: space-between; align-items: center; gap: 12px;
		padding: 16px max(var(--gutter), calc((100% - 1040px) / 2 + var(--gutter)));
		border-bottom: 1px solid var(--color-rule-strong);
	}
	.gp-place, .gp-label, .gp-sub, .gp-credits summary, .gp-credits h2 {
		font-family: var(--font-label); font-weight: 700; font-size: 11px; letter-spacing: 0.16em;
		text-transform: uppercase; color: var(--color-muted);
	}

	.gp-col { width: 100%; max-width: 720px; margin: 0 auto; padding: 36px var(--gutter) 0; }
	.gp-sec { width: 100%; max-width: 1040px; margin: 0 auto; padding: 56px var(--gutter) 0; }
	.gp-sec.gp-col { max-width: 720px; }

	.gp-h1 {
		font-family: var(--font-display); font-weight: 800; font-size: clamp(40px, 8vw, 72px);
		line-height: 0.95; letter-spacing: -0.025em; text-transform: uppercase;
	}

	:global(body) { background: var(--color-bg); color: var(--color-text); }

	.gp-copy { margin-top: 16px; font-size: 17px; line-height: 1.45; color: #d4d4d4; max-width: 680px; }
	.gp-cta { color: var(--accent); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
	.gp-cta:hover { color: #fff; }
	.gp-lede { font-size: 20px; }
	.gp-narrow { max-width: 680px; margin-bottom: 8px; }
	.gp-clip figcaption > span:first-child { display: block; color: var(--color-text); font-weight: 600; }
	.gp-tag { display: block; margin-top: 2px; color: #a3a3a3; }

	.gp-label { margin-bottom: 16px; padding-top: 16px; border-top: 1px solid var(--color-rule-strong); }
	.gp-sub { margin: 32px 0 12px; color: var(--color-text); }

	.gp-grid { display: grid; grid-template-columns: 1fr; gap: 24px; }
	@media (min-width: 720px) { .gp-grid { grid-template-columns: 1fr 1fr; } }
	.gp-clip video { aspect-ratio: 16 / 9; border-radius: 4px; }
	.gp-clip figcaption { margin-top: 8px; font-size: 14px; color: #d4d4d4; }

	.gp-tall { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; max-width: 760px; }
	.gp-tall > div { min-width: 0; }
	.gp-tall video { display: block; width: 100%; aspect-ratio: 9 / 16; border-radius: 6px; }

	/* Award cards: a row that fits the width (4 across, 3 under 720px, 2 under 480px). Each slot
	 * swaps its card by itself, one slot at a time, so the games keep mixing. */
	.gp-cards { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; max-width: 1000px; }
	@media (max-width: 720px) { .gp-cards { grid-template-columns: repeat(3, minmax(0, 1fr)); } .gp-slot:nth-child(4) { display: none; } }
	@media (max-width: 480px) { .gp-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } .gp-slot:nth-child(3) { display: none; } }
	.gp-slot { position: relative; aspect-ratio: 4 / 5; }
	.gp .gp-slot :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border-radius: 6px; }
	/* Build off: the old card tips and drops away (ease in). Build in: the new card drops in from
	 * above with a small overshoot (ease out back), starting as the old one clears. Script adds
	 * the new <img>, which has no Astro scope attribute, hence :global. */
	.gp-slot :global(img.is-out) { animation: gp-card-out 300ms cubic-bezier(.32, 0, .67, 0) both; }
	.gp-slot :global(img.is-new) { animation: gp-card-in 560ms cubic-bezier(.34, 1.5, .64, 1) 140ms both; }

	.gp-credits { margin: 64px 0 48px; border-top: 1px solid var(--color-rule-strong); }
	.gp-credits summary { list-style: none; cursor: pointer; padding: 16px 0; color: var(--color-text); }
	.gp-credits summary::-webkit-details-marker { display: none; }
	.gp-credits summary::before { content: '▸' / ''; display: inline-block; margin-right: 8px; transition: transform 200ms var(--out); }
	.gp-credits[open] summary::before { transform: rotate(90deg); }
	.gp-credits-body { display: flex; flex-direction: column; gap: 18px; padding-bottom: 8px; font-size: 13px; line-height: 1.5; color: #b3b3b3; overflow-wrap: anywhere; }
	.gp-credits-body ul { list-style: none; display: flex; flex-direction: column; gap: 4px; }
	.gp-credits h2 { font-size: 10px; margin-bottom: 4px; }
	.gp-credits a { color: #d4d4d4; text-underline-offset: 2px; }

	@media (prefers-reduced-motion: no-preference) {
		.b { transition: opacity 360ms var(--out) var(--d), transform 360ms var(--out) var(--d); }
		.is-pre .b { opacity: 0; transform: translateY(14px); }
		.is-pre .gp-hero { transform: none; }
		.is-pre ~ :global(.footer) { opacity: 0; }

		.r {
			opacity: 0; transform: translateY(18px);
			transition: opacity 260ms var(--in), transform 260ms var(--in);
		}
		.r.is-in {
			opacity: 1; transform: none;
			transition: opacity 480ms var(--out) calc(70ms * var(--i, 0)), transform 480ms var(--out) calc(70ms * var(--i, 0));
		}

		.is-leaving .b, .is-leaving .r.is-in {
			opacity: 0; transform: translateY(-6px);
			transition: opacity 140ms var(--in) calc(220ms - var(--d, 0ms)), transform 140ms var(--in) calc(220ms - var(--d, 0ms));
		}
		.is-leaving ~ :global(.footer) { opacity: 0; transition: opacity 100ms var(--in); }

		.gp-credits[open] .gp-credits-body > section { animation: gp-in 300ms var(--out) both; }
		.gp-credits.is-closing .gp-credits-body > section { animation: gp-out 160ms var(--in) both; }
	}
	@keyframes gp-card-out { to { opacity: 0; transform: translateY(22px) rotate(-4deg) scale(.94); } }
	@keyframes gp-card-in { from { opacity: 0; transform: translateY(-26px) rotate(3deg) scale(.96); } }
	@keyframes gp-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
	@keyframes gp-out { from { opacity: 1; } to { opacity: 0; transform: translateY(-4px); } }
</style>

<script>
	const main = document.getElementById('gp');
	const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

	if (main) {
		requestAnimationFrame(() => requestAnimationFrame(() => main.classList.remove('is-pre')));
		window.addEventListener('pageshow', (e) => { if (e.persisted) main.classList.remove('is-leaving', 'is-pre'); });

		// Scroll reveals: in on entering, out on leaving.
		const reveal = new IntersectionObserver((entries) => {
			for (const e of entries) e.target.classList.toggle('is-in', e.isIntersecting);
		}, { threshold: 0.15 });
		main.querySelectorAll('.r').forEach((el) => reveal.observe(el));

		// Gif-style loops: play only while on screen; never under reduced motion.
		const vids = new IntersectionObserver((entries) => {
			for (const e of entries) {
				const v = e.target as HTMLVideoElement;
				if (e.isIntersecting && !reduced.matches) {
					if (v.preload === 'none') v.preload = 'auto';
					v.muted = true;
					v.play().catch(() => armTapToPlay());
				} else v.pause();
			}
		}, { threshold: 0.25 });
		main.querySelectorAll('video.loop').forEach((v) => vids.observe(v));

		// iOS refuses muted autoplay in Low Power Mode (every iOS browser is WebKit). A tap is a
		// user gesture, so each tap starts the paused loops on screen (WebKit grants it per video).
		let armed = false;
		function armTapToPlay() {
			if (armed) return;
			armed = true;
			const go = () => {
				main!.querySelectorAll('video.loop').forEach((el) => {
					const v = el as HTMLVideoElement;
					const r = v.getBoundingClientRect();
					if (v.paused && r.bottom > 0 && r.top < innerHeight) v.play().catch(() => {});
				});
			};
			for (const t of ['touchend', 'click']) document.addEventListener(t, go, { passive: true });
		}

		// Award cards: every 1.7 s one visible slot swaps its card for the next one in the deck that
		// is not showing and comes from another game. Runs only while on screen and the tab is visible.
		const cards = main.querySelector<HTMLElement>('.gp-cards');
		if (cards && !reduced.matches) {
			const deck: { src: string; alt: string; game: string }[] = JSON.parse(cards.dataset.deck || '[]');
			const slots = [...cards.querySelectorAll<HTMLElement>('.gp-slot')];
			let turn = 0, tick = 0, onScreen = false, timer = 0;
			const lastShown: Record<string, number> = {}, dealt: Record<string, number> = {};
			const order = [0, 2, 1, 3];
			const swap = async () => {
				const live = slots.filter((s) => s.offsetParent !== null);
				const showing = new Set(slots.map((s) => s.querySelector('img:not(.is-out)')?.getAttribute('src')));
				const slot = order.map((i) => slots[i]).filter((s) => live.includes(s))[turn++ % live.length];
				const old = slot.querySelector('img:not(.is-out)');
				const leaving = deck.find((d) => d.src === old?.getAttribute('src'))?.game;
				// The game shown least recently (other than the one leaving) goes next, and each game
				// deals its own cards in turn, so every card comes round.
				const games = [...new Set(deck.map((d) => d.game))]
					.filter((g) => g !== leaving && deck.some((d) => d.game === g && !showing.has(d.src)))
					.sort((x, y) => (lastShown[x] ?? -1) - (lastShown[y] ?? -1));
				const game = games[0] ?? leaving;
				const hand = deck.filter((d) => d.game === game && !showing.has(d.src));
				if (!game || !hand.length) return;
				const card = hand[(dealt[game] = (dealt[game] ?? -1) + 1) % hand.length];
				lastShown[game] = tick++;
				const img = new Image(640, 800);
				img.src = card.src; img.alt = card.alt; img.decoding = 'async';
				try { await img.decode(); } catch { return; }
				img.className = 'is-new';
				old?.classList.add('is-out');
				slot.append(img);
				setTimeout(() => { old?.remove(); img.classList.remove('is-new'); }, 760);
			};
			const run = () => {
				clearInterval(timer);
				if (onScreen && !document.hidden) timer = window.setInterval(swap, 1700);
			};
			new IntersectionObserver(([e]) => { onScreen = e.isIntersecting; run(); }, { threshold: 0.3 }).observe(cards);
			document.addEventListener('visibilitychange', run);
		}

		// Build off on a same-tab link tap, then navigate.
		document.addEventListener('click', (e) => {
			const a = e.target instanceof Element ? e.target.closest('a[href]') : null;
			if (!(a instanceof HTMLAnchorElement) || !a.closest('.gp, .footer')) return;
			if (a.target === '_blank' || reduced.matches || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
			e.preventDefault();
			if (main.classList.contains('is-leaving')) return;
			main.classList.add('is-leaving');
			setTimeout(() => { window.location.href = a.href; }, 400);
		});

		// Credits close: let the groups drop away first.
		const credits = main.querySelector('.gp-credits');
		if (credits instanceof HTMLDetailsElement) {
			credits.querySelector('summary')?.addEventListener('click', (e) => {
				if (!credits.open || reduced.matches) return;
				e.preventDefault();
				credits.classList.add('is-closing');
				setTimeout(() => { credits.open = false; credits.classList.remove('is-closing'); }, 180);
			});
		}
	}
</script>
