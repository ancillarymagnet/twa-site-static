---
// thirdwave.fun/next: the page Gary's Party Line's CTA screen and its QR open, at every venue (was /wndrvl,
// renamed 2026-11-19 so no venue's name is in it; /wndrvl now 404s, Noah's call).
// Signup first, under the moire band; then links out. No game credits: those are LINE's (garys-party-line).
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import EmailSignup from '../components/EmailSignup.astro';
import { getEntry } from 'astro:content';

const siteEntry = await getEntry('site', 'site');
const siteData = siteEntry.data;

const DEV_URL = 'https://thirdwave.fun/dev/';
// The survey row renders only when this is set. No placeholder ships.
const SURVEY_URL: string | null = null;

const links = [
	{ text: 'Build for this screen', href: DEV_URL, newTab: false },
	{ text: 'Get the SDK', href: DEV_URL, newTab: false },
	{
		text: 'Follow',
		socials: [
			{ text: 'Instagram', href: siteData.social.instagram },
			{ text: 'YouTube', href: siteData.social.youtube },
			{ text: 'TikTok', href: siteData.social.tiktok },
		],
	},
	...(SURVEY_URL ? [{ text: 'Say how it went.', href: SURVEY_URL, newTab: true }] : []),
];

---

<Layout
	title="Third Wave — Play New Games"
	description="Get invited to play the next new game from Third Wave."
	socialDescription="Play new games. Sign up to find out where we'll be next."
>
	<main class="wv" id="wv">
		<script is:inline>
			// Hold everything at its pre-build-in state until the page script starts the build-in.
			// Only this script applies is-pre: without JS the page simply shows, and if the page
			// script never runs, this timer releases the page anyway.
			(function (main) {
				main.classList.add('is-pre');
				setTimeout(function () { main.classList.remove('is-pre'); }, 1500);
			})(document.currentScript.parentElement);
		</script>

		<div class="wv-band" aria-hidden="true">
			<img src="/images/wndrvl-band.webp" alt="" width="1170" height="450" decoding="async" />
		</div>

		<div class="wv-top">
			<span class="wv-mark">Third Wave</span>
		</div>

		<div class="wv-col">
			<h1 class="wv-h1">PLAY NEW GAMES.</h1>
			<p class="wv-lede">Sign up to find out where we'll be next.</p>

			<div class="wv-signup">
				<EmailSignup placeholder="you@example.com" buttonText="GET INVITED" cueText="" />
			</div>

			<ul class="wv-links" style={`--n: ${links.length}`}>
				{links.map((link, i) => (
					<li>
						{'socials' in link ? (
							<div class="wv-row wv-social" style={`--i: ${i}`}>
								<span>{link.text}</span>
								{link.socials.map((s) => (
									<a href={s.href} target="_blank" rel="noopener noreferrer">{s.text}</a>
								))}
							</div>
						) : (
							<a
								class="wv-row"
								style={`--i: ${i}`}
								href={link.href}
								{...(link.newTab ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
							>
								<span>{link.text}</span>
								<span class="wv-arrow" aria-hidden="true">&#x2197;&#xFE0E;</span>
							</a>
						)}
					</li>
				))}
			</ul>

		</div>
	</main>

	<Footer
		production={siteData.footer.production}
		copyrightHolder={siteData.footer.copyrightHolder}
		youtube={siteData.social.youtube}
		instagram={siteData.social.instagram}
	/>
</Layout>

<style>
	/*
	 * Motion: every element builds in on load and builds off on a same-tab link tap.
	 * Build-in uses the base transitions (ease out); build-off uses the .is-leaving ones (ease in).
	 * The pre-build-in state only exists for no-preference motion, so reduced motion shows all at once.
	 */
	.wv {
		--out: cubic-bezier(.33, 1, .68, 1);
		--in: cubic-bezier(.32, 0, .67, 0);
		--gutter: 22px;
		display: flex;
		flex-direction: column;
	}

	/* Band: the baked moire, 150 px tall at 390 px wide. */
	.wv-band {
		position: relative;
		width: 100%;
		aspect-ratio: 1170 / 450;
		max-height: 240px;
		overflow: hidden;
		background: var(--color-bg);
		transition: opacity 300ms var(--out) 0ms;
	}

	.wv-band img {
		position: absolute;
		top: 0;
		left: -4%;
		width: 108%;
		height: 100%;
		object-fit: cover;
		display: block;
		animation: wv-drift 20s ease-in-out infinite alternate;
	}

	/* ±4% of the frame; the image is 108% of the frame, so 4 / 108. */
	@keyframes wv-drift {
		from { transform: translateX(-3.7037%); }
		to { transform: translateX(3.7037%); }
	}

	/* Top line: the wordmark, hairline under. */
	.wv-top {
		display: flex;
		justify-content: space-between;
		align-items: center;
		/* Inset to the column's edges on wide screens. */
		padding: 16px max(var(--gutter), calc((100% - 520px) / 2 + var(--gutter)));
		border-bottom: 1px solid var(--color-rule-strong);
		transition: opacity 280ms var(--out) 80ms, transform 280ms var(--out) 80ms;
	}

	.wv-mark {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 15px;
		line-height: 0.9;
		letter-spacing: -0.02em;
		text-transform: uppercase;
	}


	.wv-col {
		width: 100%;
		max-width: 520px;
		margin: 0 auto;
		padding: 36px var(--gutter) 56px;
	}

	.wv-h1 {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: clamp(40px, 7vw, 56px);
		line-height: 0.95;
		letter-spacing: -0.025em;
		text-transform: uppercase;
		transition: opacity 360ms var(--out) 140ms, transform 360ms var(--out) 140ms;
	}

	.wv-lede {
		margin-top: 14px;
		font-family: var(--font-sans);
		font-size: 20px;
		line-height: 1.25;
		letter-spacing: -0.01em;
		color: #d4d4d4;
		transition: opacity 340ms var(--out) 220ms, transform 340ms var(--out) 220ms;
	}

	.wv-signup {
		margin-top: 28px;
		transition: opacity 400ms var(--out) 300ms, transform 400ms var(--out) 300ms;
	}

	.wv-signup :global(.signup-wrap) {
		padding: 0;
		align-items: stretch;
	}

	.wv-signup :global(.form-group) {
		max-width: none;
	}

	.wv-signup :global(.submit-btn) {
		transition: opacity 0.2s ease, transform 400ms var(--out) 300ms;
	}

	/* Collapse the empty status line without taking the live region out of the a11y tree. */
	.wv-signup :global(.form-message:empty) {
		margin-top: 0;
	}

	/* The site footer comes in last. It is main's sibling, so it does not
	   inherit --out/--in from .wv: the curves are spelled out. */
	.wv ~ :global(.footer) {
		transition: opacity 280ms cubic-bezier(.33, 1, .68, 1) 620ms;
	}

	/* Links: text rows with hairlines, ↗ after the text. */
	.wv-links {
		list-style: none;
		margin-top: 28px;
	}

	.wv-row {
		display: flex;
		align-items: baseline;
		gap: 8px;
		padding: 17px 0;
		border-top: 1px solid var(--color-rule-strong);
		color: var(--color-text);
		text-decoration: none;
		font-size: 16px;
		line-height: 1.3;
		transition:
			opacity 300ms var(--out) calc(380ms + 60ms * var(--i)),
			transform 300ms var(--out) calc(380ms + 60ms * var(--i)),
			color 0.2s ease;
	}

	.wv-row:hover { color: #b3b3b3; }

	.wv-social { gap: 18px; flex-wrap: wrap; }
	.wv-social:hover { color: var(--color-text); }
	.wv-social a { color: inherit; text-decoration: none; }
	.wv-social a:hover { color: #b3b3b3; }
	.wv-social span:first-child { color: var(--color-muted); }

	.wv-arrow {
		font-size: 14px;
	}

	@media (prefers-reduced-motion: no-preference) {
		/* Pre-build-in state. */
		.is-pre .wv-band { opacity: 0; }
		.is-pre .wv-top { opacity: 0; transform: translateY(8px); }
		.is-pre .wv-h1 { opacity: 0; transform: translateY(16px); }
		.is-pre .wv-lede { opacity: 0; transform: translateY(12px); }
		.is-pre .wv-signup { opacity: 0; transform: translateY(12px); }
		.is-pre .wv-signup :global(.submit-btn) { transform: scale(0.96); }
		.is-pre .wv-row { opacity: 0; transform: translateY(8px); }
		.is-pre ~ :global(.footer) { opacity: 0; }

		/* Footer leaves first. */
		.is-leaving ~ :global(.footer) {
			opacity: 0;
			transition: opacity 100ms cubic-bezier(.32, 0, .67, 0) 0ms;
		}

		/* Build-off: links in reverse, then up the page, band last (done by 380 ms). */
		.is-leaving .wv-row {
			opacity: 0;
			transform: translateY(-6px);
			transition:
				opacity 120ms var(--in) calc(40ms + 40ms * (var(--n) - 1 - var(--i))),
				transform 120ms var(--in) calc(40ms + 40ms * (var(--n) - 1 - var(--i)));
		}
		.is-leaving .wv-signup {
			opacity: 0;
			transform: translateY(-6px);
			transition: opacity 140ms var(--in) 100ms, transform 140ms var(--in) 100ms;
		}
		.is-leaving .wv-lede {
			opacity: 0;
			transform: translateY(-6px);
			transition: opacity 120ms var(--in) 120ms, transform 120ms var(--in) 120ms;
		}
		.is-leaving .wv-h1 {
			opacity: 0;
			transform: translateY(-6px);
			transition: opacity 140ms var(--in) 140ms, transform 140ms var(--in) 140ms;
		}
		.is-leaving .wv-top {
			opacity: 0;
			transform: translateY(-6px);
			transition: opacity 120ms var(--in) 160ms, transform 120ms var(--in) 160ms;
		}
		.is-leaving .wv-band {
			opacity: 0;
			transition: opacity 200ms var(--in) 180ms;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.wv-band img { animation: none; transform: none; }
	}
</style>

<script>
	const main = document.getElementById('wv');
	const band = main?.querySelector('.wv-band');
	const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

	if (main) {
		// Build in: drop the pre state once it has painted, so the transitions run.
		requestAnimationFrame(() => requestAnimationFrame(() => main.classList.remove('is-pre')));

		// Coming back through the back/forward cache: show the page again.
		window.addEventListener('pageshow', (e) => {
			if (e.persisted) main.classList.remove('is-leaving', 'is-pre');
		});

		// Build off on a same-tab link tap (page or site footer), then navigate.
		// New-tab links and the signup do not build off.
		document.addEventListener('click', (e) => {
			const a = e.target instanceof Element ? e.target.closest('a[href]') : null;
			if (!a || !(a instanceof HTMLAnchorElement)) return;
			if (!a.closest('.wv, .footer')) return;
			if (a.target === '_blank' || reduced.matches) return;
			if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
			if (main.classList.contains('is-leaving')) {
				e.preventDefault();
				return;
			}
			e.preventDefault();
			const href = a.href;
			let gone = false;
			const go = () => {
				if (gone) return;
				gone = true;
				window.location.href = href;
			};
			band?.addEventListener('transitionend', (t) => {
				if (t.target === band && t.propertyName === 'opacity') go();
			}, { once: true });
			setTimeout(go, 400);
			main.classList.add('is-leaving');
		});
	}
</script>
