---
export interface Props {
	production?: string;
	copyrightHolder: string;
	youtube?: string;
	instagram?: string;
}

const { production, copyrightHolder, youtube, instagram } = Astro.props;

const buildYear = new Date().getFullYear();
const holder = copyrightHolder.trim();
const hasLinks = Boolean(youtube || instagram);
---

<footer class="footer">
	<div class="left">
		{production && <p class="yfc">{production}</p>}
		<p class="copy">
			© <span class="js-current-year" data-build-year={buildYear}>{buildYear}</span>
			{holder ? ` ${holder}` : ''}
		</p>
		<p class="legal">
			<a class="privacy" href="/privacy">Privacy Policy</a>
			<a class="privacy" href="/support">Support</a>
			<a class="privacy choices" href="/privacy#your-privacy-choices" data-tw-choices>Your Privacy Choices <svg class="ccpa-icon" viewBox="0 0 30 14" width="26" height="12" aria-hidden="true"><path d="M7.4 12.8h8.1L18.7 1.2H7.4a5.8 5.8 0 0 0 0 11.6z" fill="#fff"/><path d="M22.6 0H7.4a7 7 0 0 0 0 14h15.2a7 7 0 0 0 0-14zM1.2 7a6.2 6.2 0 0 1 6.2-6.2h11.3L15.4 13.2H7.4A6.2 6.2 0 0 1 1.2 7z" fill="#06f"/><path d="M24.4 4l.9.9L23.2 7l2.1 2.1-.9.9-2.1-2.1-2.1 2.1-.9-.9L21.4 7l-2.1-2.1.9-.9 2.1 2.1z" fill="#fff"/><path d="M12.2 4.4l.9.9-4.1 4.1-2.4-2.4.9-.9 1.5 1.5z" fill="#06f"/></svg></a>
		</p>
	</div>
	{hasLinks && (
		<div class="links">
			{youtube && <a href={youtube} target="_blank" rel="noopener noreferrer">YouTube&#xA0;&#x2197;&#xFE0E;</a>}
			{instagram && <a href={instagram} target="_blank" rel="noopener noreferrer">Instagram&#xA0;&#x2197;&#xFE0E;</a>}
		</div>
	)}
</footer>

<script is:inline>
	const currentYear = new Date().getFullYear();
	for (const element of document.querySelectorAll('.js-current-year')) {
		const buildYear = Number(element.getAttribute('data-build-year'));
		if (!Number.isNaN(buildYear) && buildYear === currentYear) continue;
		element.textContent = String(currentYear);
	}
</script>

<style>
	.footer {
		padding: 48px 40px 32px;
		border-top: 1px solid var(--color-rule);
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		flex-wrap: wrap;
		gap: 24px;
		margin-top: auto;
	}

	.left {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.yfc {
		font-family: var(--font-sans);
		font-weight: 400;
		font-size: 16px;
		color: #b3b3b3;
		line-height: 1.35;
		max-width: 360px;
	}

	.copy {
		font-family: var(--font-label);
		font-size: 11px;
		color: #888;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.legal {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		margin: 0;
	}

	.privacy {
		font-family: var(--font-label);
		font-size: 10px;
		color: #555;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.privacy:hover { color: #b3b3b3; }

	.choices {
		display: inline-flex;
		align-items: center;
		gap: 6px;
	}

	.ccpa-icon { flex-shrink: 0; }

	.links {
		display: flex;
		gap: 20px;
		font-family: var(--font-label);
		font-size: 12px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.links a {
		color: #b3b3b3;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.links a:hover { color: var(--color-text); }

	@media (max-width: 820px) {
		.footer {
			padding: 28px 22px 22px;
			flex-direction: column;
			align-items: flex-start;
			gap: 16px;
		}

		.yfc { font-size: 14px; }
		.copy { font-size: 10px; letter-spacing: 0.14em; }
		.links { gap: 16px; font-size: 11px; letter-spacing: 0.13em; }
	}
</style>
